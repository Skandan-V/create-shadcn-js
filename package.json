{
  "name": "create-shadcn-js",
  "version": "1.1.0",
  "description": "Scaffold a Vite + React + shadcn/ui JavaScript project with zero manual configuration.",
  "type": "module",
  "bin": {
    "create-shadcn-js": "bin/cli.js"
  },
  "main": "./src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "bin",
    "src",
    "README.md",
    "LICENSE",
    "SECURITY.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "scripts": {
    "start": "node ./bin/cli.js",
    "test": "node ./bin/cli.js --help",
    "audit": "npm audit --audit-level=high"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Skandan-V/create-shadcn-js.git"
  },
  "keywords": [
    "create-shadcn-js",
    "shadcn",
    "shadcn-ui",
    "vite",
    "react",
    "javascript",
    "jsx",
    "tailwind",
    "tailwindcss",
    "cli",
    "scaffold",
    "clack"
  ],
  "author": "Skandan-V <skandan.studio4as@gmail.com>",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/Skandan-V/create-shadcn-js/issues"
  },
  "homepage": "https://github.com/Skandan-V/create-shadcn-js#readme",
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@clack/prompts": "^0.9.1",
    "commander": "^13.1.0",
    "cross-spawn": "^7.0.6",
    "fs-extra": "^11.3.0",
    "picocolors": "^1.1.1"
  }
}
